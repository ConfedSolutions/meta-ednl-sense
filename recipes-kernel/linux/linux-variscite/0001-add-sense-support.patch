From 8a7f63903e94462c067afd21df9fb04970a26a1a Mon Sep 17 00:00:00 2001
From: "N. van IJzendoorn" <nick.vanijzendoorn@confed.eu>
Date: Thu, 12 Mar 2026 11:13:46 +0100
Subject: [PATCH] add sense support

---
 arch/arm64/boot/dts/freescale/Makefile        |   1 +
 .../dts/freescale/imx91-var-som-sense.dts     |  13 +
 .../dts/freescale/imx91-var-som-sense.dtsi    | 598 ++++++++++++++++++
 3 files changed, 612 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx91-var-som-sense.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx91-var-som-sense.dtsi

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 7a47bceebb2a..73cd368b39ca 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -744,6 +744,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx91-9x9-qsb-i3c.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx91-var-dart-dt8mcustomboard.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx91-var-dart-sonata.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx91-var-som-symphony.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx91-var-som-sense.dtb
 
 imx91-var-dart-dt8mcustomboard-ld-dtbs := imx91-var-dart-dt8mcustomboard.dtb imx91-var-som-ld.dtbo
 imx91-var-dart-sonata-ld-dtbs := imx91-var-dart-sonata.dtb imx91-var-som-ld.dtbo
diff --git a/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dts b/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dts
new file mode 100644
index 000000000000..4343d2319bae
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dts
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 Confed Solutions
+ */
+
+/dts-v1/;
+
+#include "imx91-var-som.dtsi"
+#include "imx91-var-som-sense.dtsi"
+
+/ {
+	model = "Variscite VAR-SOM-MX91 2.x and newer on EDNL Sense v4";
+};
diff --git a/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dtsi b/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dtsi
new file mode 100644
index 000000000000..ee84311ee382
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx91-var-som-sense.dtsi
@@ -0,0 +1,598 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2024 NXP
+ * Copyright 2025 Variscite Ltd.
+ * Copyright 2025 Confed Solutions
+ */
+
+/ {
+	/delete-node/ sound-wm8904;
+
+	aliases {
+		ethernet0 = &eqos;
+		ethernet1 = &fec;
+	};
+
+	chosen {
+		stdout-path = &lpuart1;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		status = "okay";
+
+		heartbeat {
+			label = "Heartbeat";
+			gpios = <&gpio2 21 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&tpm3 1 40000 0>;	/* 25KHz PWM */
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <80>;
+	};
+
+	reg_fec_phy: regulator-fec-phy {
+		compatible = "regulator-fixed";
+		regulator-name = "fec-phy";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-enable-ramp-delay = <20000>;
+		gpio = <&gpio3 28 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	reg_vref_1v8: regulator-adc-vref {
+		compatible = "regulator-fixed";
+		regulator-name = "vref_1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			alloc-ranges = <0 0x80000000 0 0x40000000>;
+			size = <0 0x10000000>;
+			linux,cma-default;
+		};
+
+		ele_reserved: ele-reserved@a4120000 {
+			compatible = "shared-dma-pool";
+			reg = <0 0xa4120000 0 0x100000>;
+			no-map;
+		};
+	};
+};
+
+&adc1 {
+	vref-supply = <&reg_vref_1v8>;
+	status = "okay";
+};
+
+&ele_fw2 {
+	memory-region = <&ele_reserved>;
+};
+
+&eqos {
+	mdio {
+		ethphy1: ethernet-phy@5 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <5>;
+			eee-broken-1000t;
+			reset-gpios = <&gpio4 28 GPIO_ACTIVE_LOW>;
+			reset-assert-us = <15000>;
+			reset-deassert-us = <100000>;
+			mxl-8611x,led0_cfg = <(
+				MXL8611X_LEDX_CFG_LINK_UP_RX_ACT_ON |
+				MXL8611X_LEDX_CFG_LINK_UP_TX_ACT_ON |
+				MXL8611X_LEDX_CFG_TRAFFIC_ACT_BLINK_IND
+			)>;
+			mxl-8611x,led1_cfg = <( /* unused, but keep to keep var-mii happy */
+				MXL8611X_LEDX_CFG_LINK_UP_10MB_ON |
+				MXL8611X_LEDX_CFG_LINK_UP_100MB_ON |
+				MXL8611X_LEDX_CFG_LINK_UP_1GB_ON
+			)>;
+			mxl-8611x,led2_cfg = <(
+				MXL8611X_LEDX_CFG_LINK_UP_10MB_ON |
+				MXL8611X_LEDX_CFG_LINK_UP_100MB_ON |
+				MXL8611X_LEDX_CFG_LINK_UP_1GB_ON
+			)>;
+		};
+	};
+};
+
+&fec {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_fec>;
+	pinctrl-1 = <&pinctrl_fec_sleep>;
+	phy-mode = "rgmii-rxid";
+	phy-handle = <&ethphy1>;
+	phy-supply = <&reg_fec_phy>;
+	status = "okay";
+};
+
+&flexcan1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_flexcan1>;
+	status = "okay";
+};
+
+&flexcan2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_flexcan2>;
+	status = "okay";
+};
+
+&gpio1 {
+	gpio-line-names = "I2C1_SCL",
+		"I2C1_SDA",
+		"I2C2_SCL",
+		"I2C2_SDA",
+		"UART1_RXD",
+		"UART1_TXD",
+		"UART2_RXD",
+		"UART2_TXD",
+		"CAN1_TX",
+		"CAN1_RX",
+		"USB1_ID",
+		"SAI1_TXFS",
+		"SAI1_TXC",
+		"SAI1_TXD0",
+		"SAI1_RXD0",
+		"WDOG_ANY",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC";
+};
+
+&gpio2 {
+	gpio-line-names = "DISPLAY_CS",
+		"DISPLAY_MISO",
+		"DISPLAY_MOSI",
+		"DISPLAY_CLK",
+		"UART6_TX",
+		"UART6_RX",
+		"UART6_CABLE_FAULT",
+		"UART6_RTS",
+		"UART7_TX",
+		"UART7_RX",
+		"LED5",
+		"UART7_RTS",
+		"UART6_RS485/RS232_N",
+		"UART6_HALF/FULL_N",
+		"UART6_TERM",
+		"UART6_FD_TX_TERM",
+		"DISPLAY_DATA/CMD",
+		"CAN2_TERM",
+		"LED3",
+		"DISPLAY_RST_N",
+		"DISPLAY_BL_PWM",
+		"LED2",
+		"SHUTDOWN",
+		"GPO1",
+		"BUZZER_N",
+		"GPO2",
+		"LED4",
+		"WD_RST",
+		"I2C_SDA_PMIC",
+		"I2C_SCL_PMIC",
+		"NC",
+		"NC";
+};
+
+&gpio3 {
+	gpio-line-names = "GPI1",
+		"MDINT_N",
+		"GPI2",
+		"CAN2_TX",
+		"CAN2_RX",
+		"I2C1_09H_INT",
+		"NC",
+		"NC",
+		"SD1_CLK (eMMC)",
+		"SD1_CMD (eMMC)",
+		"SD1_DATA0 (eMMC)",
+		"SD1_DATA1 (eMMC)",
+		"SD1_DATA2 (eMMC)",
+		"SD1_DATA3 (eMMC)",
+		"SD1_DATA4 (eMMC)",
+		"SD1_DATA5 (eMMC)",
+		"SD1_DATA6 (eMMC)",
+		"SD1_DATA7 (eMMC)",
+		"SD1_STROBE (eMMC)",
+		"SD2_VSELECT",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"NC",
+		"CAN1_TERM",
+		"DISPLAY_TOUCH_INT_N",
+		"MDIO_EN",
+		"WL_PWRKEY",
+		"NC",
+		"WL_RESET";
+};
+
+&gpio4 {
+	gpio-line-names = "ENET1_MDC",
+		"ENET1_MDIO",
+		"ENET1_TD3",
+		"ENET1_TD2",
+		"ENET1_TD1",
+		"ENET1_TD0",
+		"ENET1_TX_CTL",
+		"ENET1_TXC",
+		"ENET1_RX_CTL",
+		"ENET1_RXC",
+		"ENET1_RD0",
+		"ENET1_RD1",
+		"ENET1_RD2",
+		"ENET1_RD3",
+		"NC",
+		"BT_ENABLE",
+		"ENET2_TD3",
+		"ENET2_TD2",
+		"ENET2_TD1",
+		"ENET2_TD0",
+		"ENET2_TX_CTL",
+		"ENET2_TXC",
+		"ENET2_RX_CTL",
+		"ENET2_RXC",
+		"ENET2_RD0",
+		"ENET2_RD1",
+		"ENET2_RD2",
+		"ENET2_RD3",
+		"PHY_RST_N",
+		"NC",
+		"NC",
+		"NC";
+};
+
+&iomuxc {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_hog>;
+
+	pinctrl_hog: hoggrp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO27__GPIO2_IO27			0x51e /* out: WD_RST */
+			MX91_PAD_GPIO_IO21__GPIO2_IO21			0x51e /* out: LED2 */
+			MX91_PAD_GPIO_IO18__GPIO2_IO18			0x51e /* out: LED3 */
+			MX91_PAD_GPIO_IO26__GPIO2_IO26			0x51e /* out: LED4 */
+			MX91_PAD_GPIO_IO10__GPIO2_IO10			0x51e /* out: LED5 */
+			MX91_PAD_GPIO_IO23__GPIO2_IO23			0x51e /* out: GPO1 */
+			MX91_PAD_GPIO_IO25__GPIO2_IO25			0x51e /* out: GPO2 */
+			MX91_PAD_SD2_CD_B__GPIO3_IO0			0x11e /* in:  GPI1 */
+			MX91_PAD_SD2_CMD__GPIO3_IO2			0x11e /* in:  GPI2 */
+			MX91_PAD_GPIO_IO24__GPIO2_IO24			0x31e /* out: BUZZER_N */
+			MX91_PAD_GPIO_IO22__GPIO2_IO22			0x11e /* out: SHDN */
+			MX91_PAD_DAP_TDO_TRACESWO__GPIO3_IO31		0x51e /* out: WL_RESET */ 
+			MX91_PAD_DAP_TMS_SWDIO__GPIO3_IO29		0x51e /* out: WL_PWRKEY */
+		>;
+	};
+
+	pinctrl_captouch: captouchgrp {
+		fsl,pins = <
+			MX91_PAD_CCM_CLKO2__GPIO3_IO27			0x31e /* in:  TOUCH_INTERRUPTn */
+		>;
+	};
+
+	pinctrl_extcon: extcongrp {
+		fsl,pins = <
+			MX91_PAD_PDM_BIT_STREAM1__GPIO1_IO10		0x31e
+		>;
+	};
+
+	pinctrl_fec: fecgrp {
+		fsl,pins = <
+			MX91_PAD_ENET2_RD0__ENET2_RGMII_RD0		0x57e
+			MX91_PAD_ENET2_RD1__ENET2_RGMII_RD1		0x57e
+			MX91_PAD_ENET2_RD2__ENET2_RGMII_RD2		0x57e
+			MX91_PAD_ENET2_RD3__ENET2_RGMII_RD3		0x57e
+			MX91_PAD_ENET2_RXC__ENET2_RGMII_RXC		0x5fe
+			MX91_PAD_ENET2_RX_CTL__ENET2_RGMII_RX_CTL	0x57e
+			MX91_PAD_ENET2_TD0__ENET2_RGMII_TD0		0x57e
+			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1		0x57e
+			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2		0x57e
+			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3		0x57e
+			MX91_PAD_ENET2_TXC__ENET2_RGMII_TXC		0x5fe
+			MX91_PAD_ENET2_TX_CTL__ENET2_RGMII_TX_CTL	0x57e
+			MX91_PAD_DAP_TDI__GPIO3_IO28			0x31e /* MDIO_EN  3 = PU 5 = PD*/
+			MX91_PAD_CCM_CLKO3__GPIO4_IO28			0x51e /* PHY_RST_N */
+		>;
+	};
+
+	pinctrl_fec_sleep: fecsleepgrp {
+		fsl,pins = <
+			MX91_PAD_ENET2_RD0__GPIO4_IO24			0x51e
+			MX91_PAD_ENET2_RD1__GPIO4_IO25			0x51e
+			MX91_PAD_ENET2_RD2__GPIO4_IO26			0x51e
+			MX91_PAD_ENET2_RD3__GPIO4_IO27			0x51e
+			MX91_PAD_ENET2_RXC__GPIO4_IO23                  0x51e
+			MX91_PAD_ENET2_RX_CTL__GPIO4_IO22		0x51e
+			MX91_PAD_ENET2_TD0__GPIO4_IO19			0x51e
+			MX91_PAD_ENET2_TD1__GPIO4_IO18			0x51e
+			MX91_PAD_ENET2_TD2__GPIO4_IO17			0x51e
+			MX91_PAD_ENET2_TD3__GPIO4_IO16			0x51e
+			MX91_PAD_ENET2_TXC__GPIO4_IO21                  0x51e
+			MX91_PAD_ENET2_TX_CTL__GPIO4_IO20               0x51e
+			MX91_PAD_DAP_TDI__GPIO3_IO28			0x51e /* MDIO_EN  3 = PU 5 = PD*/
+			MX91_PAD_CCM_CLKO3__GPIO4_IO28			0x51e /* PHY_RST_N */
+		>;
+	};
+
+	pinctrl_flexcan1: flexcan1grp {
+		fsl,pins = <
+			MX91_PAD_PDM_CLK__CAN1_TX			0x139e
+			MX91_PAD_PDM_BIT_STREAM0__CAN1_RX		0x139e
+			MX91_PAD_CCM_CLKO1__GPIO3_IO26			0x51e   /* TERM */
+		>;
+	};
+
+	pinctrl_flexcan2: flexcan2grp {
+		fsl,pins = <
+			MX91_PAD_SD2_DATA0__CAN2_TX			0x139e
+			MX91_PAD_SD2_DATA1__CAN2_RX			0x139e
+			MX91_PAD_GPIO_IO17__GPIO2_IO17			0x51e   /* TERM */
+		>;
+	};
+
+	pinctrl_lpi2c1: lpi2c1grp {
+		fsl,pins = <
+			MX91_PAD_I2C1_SCL__LPI2C1_SCL			0x40000b9e
+			MX91_PAD_I2C1_SDA__LPI2C1_SDA			0x40000b9e
+			MX91_PAD_SD2_DATA2__GPIO3_IO5			0x31e /* in:  I2C1_x09_INT */
+		>;
+	};
+
+	pinctrl_lpi2c1_gpio: lpi2c1grp-gpio {
+		fsl,pins = <
+			MX91_PAD_I2C1_SCL__GPIO1_IO0			0x31e
+			MX91_PAD_I2C1_SDA__GPIO1_IO1			0x31e
+		>;
+	};
+
+	pinctrl_lpspi6: lpspi6grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO00__GPIO2_IO0			0x31e /* out: CS */
+			MX91_PAD_GPIO_IO01__LPSPI6_SIN			0x31e
+			MX91_PAD_GPIO_IO02__LPSPI6_SOUT			0x31e
+			MX91_PAD_GPIO_IO03__LPSPI6_SCK			0x31e
+			MX91_PAD_GPIO_IO16__GPIO2_IO16			0x31e /* out: DATA / COMMAND */
+			MX91_PAD_GPIO_IO19__GPIO2_IO19			0x31e /* out: RSTn */
+		>;
+	};
+
+	pinctrl_uart1: uart1grp {
+		fsl,pins = <
+			MX91_PAD_UART1_RXD__LPUART1_RX			0x31e
+			MX91_PAD_UART1_TXD__LPUART1_TX			0x31e
+		>;
+	};
+
+	pinctrl_uart6: uart6grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO05__LPUART6_RX			0x31e
+			MX91_PAD_GPIO_IO04__LPUART6_TX			0x51e
+			MX91_PAD_GPIO_IO07__LPUART6_RTS_B		0x51e
+			MX91_PAD_GPIO_IO06__GPIO2_IO6			0x11e /* in: CABLE_FAULT */
+			MX91_PAD_GPIO_IO12__GPIO2_IO12			0x51e /* out: RS485 / RS232 */
+			MX91_PAD_GPIO_IO13__GPIO2_IO13			0x51e /* out: FULL / HALF */
+			MX91_PAD_GPIO_IO14__GPIO2_IO14			0x51e /* out: TERM */
+			MX91_PAD_GPIO_IO15__GPIO2_IO15			0x51e /* out: FD_TX_TERM */
+		>;
+	};
+
+	pinctrl_uart7: uart7grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO09__LPUART7_RX			0x31e
+			MX91_PAD_GPIO_IO08__LPUART7_TX			0x51e
+			MX91_PAD_GPIO_IO11__LPUART7_RTS_B		0x51e
+		>;
+	};
+
+	pinctrl_tpm3: tpm3grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO20__TPM3_CH1			0x51e /* out: BL_PWM */
+		>;
+	};
+};
+
+&lpi2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep", "gpio";
+	pinctrl-0 = <&pinctrl_lpi2c1>;
+	pinctrl-1 = <&pinctrl_lpi2c1_gpio>;
+	pinctrl-2 = <&pinctrl_lpi2c1_gpio>;
+	scl-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
+	sda-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+
+	/* Capacitive touch controller */
+	ft5x06_ts: ft5x06_ts@38 {
+		compatible = "edt,edt-ft5206";
+		reg = <0x38>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_captouch>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <27 IRQ_TYPE_EDGE_FALLING>;
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+		wakeup-source;
+		status = "disabled";
+	};
+
+	/* USB Type-C Controller */
+	typec@3d {
+		compatible = "nxp,ptn5150";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_extcon>;
+		reg = <0x3d>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <10 IRQ_TYPE_NONE>;
+		irq-is-id-quirk;
+		status ="okay";
+
+		port {
+			typec1_dr_sw: endpoint {
+				remote-endpoint = <&usb1_drd_sw>;
+			};
+		};
+	};
+
+	tmp1075@4b {
+		compatible = "ti,tmp1075";
+		reg = <0x4b>;
+	};
+
+	at24c256@54 {
+		compatible = "atmel,24c256","at24";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x54>;
+		pagesize = <64>;
+		size = <32768>;
+		address-width = <16>;
+	};
+};
+
+&lpspi6 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_lpspi6>;
+	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
+	assigned-clocks = <&clk IMX91_CLK_LPSPI6>;
+	assigned-clock-parents = <&clk IMX91_CLK_SYS_PLL_PFD1_DIV2>;
+	assigned-clock-rates = <50000000>;
+	status = "okay";
+
+	/* Test SPI device */
+	spidev@0 {
+		reg = <0>;
+		compatible = "var,spidev";
+		spi-max-frequency = <24000000>;
+		status = "okay";
+	};
+};
+
+/* Console */
+&lpuart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart1>;
+	status = "okay";
+};
+
+&lpuart6 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart6>;
+	fsl,uart-has-rtscts;
+	linux,rs485-enabled-at-boot-time;
+	rs485-rx-during-tx;
+	status = "okay";
+};
+
+&lpuart7 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart7>;
+	fsl,uart-has-rtscts;
+	linux,rs485-enabled-at-boot-time;
+	status = "okay";
+};
+
+&media_blk_ctrl {
+	status = "okay";
+};
+
+&mu1 {
+	status = "okay";
+};
+
+&mu2 {
+	status = "okay";
+};
+
+&tpm3 {
+	pinctrl-0 = <&pinctrl_tpm3>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&usbotg1 {
+	dr_mode = "otg";
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+	usb-role-switch;
+	disable-over-current;
+	samsung,picophy-pre-emp-curr-control = <3>;
+	samsung,picophy-dc-vol-level-adjust = <7>;
+	status = "okay";
+
+	port {
+		usb1_drd_sw: endpoint {
+			remote-endpoint = <&typec1_dr_sw>;
+		};
+	};
+};
+
+&usbotg2 {
+	disable-over-current;
+	dr_mode = "host";
+	status = "okay";
+};
