+&lpuart5 {
+	status = "disabled";
+};
+
+&lpspi8 {
+	status = "disabled";
+};
+
+/* SD */
+&usdhc2 {
+	status = "disabled";
+};
+
+/* WIFI */
+&usdhc3 {
