diff --git a/drivers/input/touchscreen/cf1124.c b/drivers/input/touchscreen/cf1124.c
new file mode 100644
index 000000000000..6fd73ca2d4e0
--- /dev/null
+++ b/drivers/input/touchscreen/cf1124.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 Confed Solutions, <nick.vanijzendoorn@confed.eu>
+ */
+
+/*
+ * This is a driver for the Sitronix CF1124 family of touch controllers.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/input.h>
+#include <linux/input/touchscreen.h>
+#include <linux/irq.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/ratelimit.h>
+
+#include <asm/unaligned.h>
+
+#define CF1124_MAX_FINGERS			2
+
+#define CF1124_REG_FW_VERSION			0x00
+#define CF1124_REG_RESOLUTION_HIGH		0x04
+#define CF1124_REG_FW_REVISION			0x0c
+#define CF1124_REG_FINGERS			0x10
+#define CF1124_REG_MAX_NUM_TOUCHES		0x3f
+#define CF1124_REG_MISC_CONTROL			0xf1
+#define CF1124_REG_SMART_WAKEUP			0xf2
+#define CF1124_REG_CHIP_ID			0xf4
+
+#define START_DELAY_MS				150
+#define STOP_DELAY_MIN_US			10000
+#define STOP_DELAY_MAX_US			15000
+
+struct cf1124_ts_data {
+	struct i2c_client *client;
+	struct input_dev *in_dev;
+	struct touchscreen_properties props;
+	struct gpio_desc *reset_gpio;
+	u32 orientation;
+	u32 max_points;
+	u32 max_x;
+	u32 max_y;
+	u8 chip_id;
+	u8 version[5];
+	u8 last_touched[CF1124_MAX_FINGERS];
+};
+
+static irqreturn_t cf1124_touch_soft_irq(int irq, void *dev_id)
+{
+	struct cf1124_ts_data *cf1124 = dev_id;
+	struct i2c_client *i2c = cf1124->client;
+	struct device *dev = &i2c->dev;
+	u8 buffer[2 + (4 * CF1124_MAX_FINGERS)];
+	int bogus_read = 0;
+	int error, idx;
+
+	memset(buffer, 0, sizeof(buffer));
+	error = i2c_smbus_read_i2c_block_data(i2c, CF1124_REG_FINGERS, 
+					      sizeof(buffer), buffer);
+	if (error < 0) {
+		dev_err_ratelimited(dev, "unable to fetch data, error: %d\n",
+				    error);
+		goto out;
+	}
+
+	for (idx = 0; idx < cf1124->max_points; idx++) {
+		// check if a touch is present
+		if (buffer[(4 * idx) + 2] & 0x80) {
+			// readout the touch data
+			int x = ((buffer[(4 * idx) + 2] & 0x70) << 4)
+				| (buffer[(4 * idx) + 3]);
+			int y = ((buffer[(4 * idx) + 2] & 0x07) << 8)
+				| (buffer[(4 * idx) + 4]);
+
+			// rotate the coordinates to reality for our product
+			switch (cf1124->orientation) {
+			default:
+			case 0:
+				// nothing to do...
+				break;
+			
+			case 90:
+				swap(x, y);
+				y = cf1124->max_y - y;
+				break;
+			
+			case 180:
+				x = cf1124->max_x - x;
+				y = cf1124->max_y - y;
+				break;
+			
+			case 270:
+				swap(x, y);
+				x = cf1124->max_x - x;
+				break;
+			}
+
+			// mark that a touch is being made
+			cf1124->last_touched[idx] = 1;
+
+			// send the received data to the input device
+			touchscreen_report_pos(cf1124->in_dev, &cf1124->props,
+					       x, y, false);
+			input_report_abs(cf1124->in_dev, ABS_PRESSURE, 1);
+			input_report_key(cf1124->in_dev, BTN_TOUCH, 1);
+			input_sync(cf1124->in_dev);
+		}
+		else if (cf1124->last_touched[idx])
+		{
+			// mark that the touch is released
+			cf1124->last_touched[idx] = 0;
+
+			// send the release to the input device
+			input_report_abs(cf1124->in_dev, ABS_PRESSURE, 0);
+			input_report_key(cf1124->in_dev, BTN_TOUCH, 0);
+			input_sync(cf1124->in_dev);
+		}
+		else if (idx == 0)
+			bogus_read = 1;
+	}
+	
+	if (bogus_read) {
+		dev_warn(dev, "useless interrupt received\n");
+	}
+
+out:
+	return IRQ_HANDLED;
+}
+
+static int cf1124_read_configuration(struct cf1124_ts_data *cf1124, int log_info)
+{
+	struct i2c_client *i2c = cf1124->client;
+	int res, x, y;
+	u8 resolution[3];
+
+	// read the chipID
+	res = i2c_smbus_read_byte_data(i2c, CF1124_REG_CHIP_ID);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read chip ID\n");
+		goto err_out;
+	}
+	
+	cf1124->chip_id = res;
+	if (log_info)
+		dev_info(&i2c->dev, "chip id: 0x%02x\n", res);
+
+	// read the firmware version information
+	res = i2c_smbus_read_byte_data(i2c, CF1124_REG_FW_VERSION);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read firmware version\n");
+		goto err_out;
+	}
+	
+	cf1124->version[0] = res;
+
+	res = i2c_smbus_read_i2c_block_data(i2c, CF1124_REG_FW_REVISION, 
+						sizeof(cf1124->version) - 1,
+						cf1124->version + 1);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read firmware revision\n");
+		goto err_out;
+	}
+	
+	if (log_info)
+		dev_info(&i2c->dev, "firmware version: %d.%d.%d.%d.%d\n", 
+			cf1124->version[0], cf1124->version[4], cf1124->version[3], 
+			cf1124->version[2], cf1124->version[1]);
+
+	// read the maximum supported touches
+	res = i2c_smbus_read_byte_data(i2c, CF1124_REG_MAX_NUM_TOUCHES);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read max number of touches\n");
+		goto err_out;
+	}
+	
+	if (res > CF1124_MAX_FINGERS)
+		res = CF1124_MAX_FINGERS;
+	cf1124->max_points = res;
+	if (log_info)
+		dev_info(&i2c->dev, "maximum num touches: %d\n", res);
+	
+	// read the configured resolution
+	res = i2c_smbus_read_i2c_block_data(i2c, CF1124_REG_RESOLUTION_HIGH, 
+						sizeof(resolution),
+						resolution);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read resolution\n");
+		goto err_out;
+	}
+	
+	// convert the data to the resolution
+	x = ((resolution[0] & 0x70) << 4)
+		| (resolution[1]);
+	y = ((resolution[0] & 0x07) << 8)
+		| (resolution[2]);
+
+	// rotate if needed
+	if (cf1124->orientation == 90 || cf1124->orientation == 270) {
+		swap(x, y);
+	}
+
+	// store the resolution
+	cf1124->max_x = x;
+	cf1124->max_y = y;
+	if (log_info)
+		dev_info(&i2c->dev, "resolution: X = %d, Y = %d\n", x, y);
+	
+	return 0;
+
+err_out:
+	return res;
+}
+
+static int cf1124_start_chip(struct input_dev *dev)
+{
+	struct cf1124_ts_data *cf1124 = input_get_drvdata(dev);
+	struct i2c_client *i2c = cf1124->client;
+	int res;
+
+	// take the chip out of reset
+	gpiod_set_value_cansleep(cf1124->reset_gpio, 0);
+	msleep(START_DELAY_MS);
+
+	// read the chip configuration
+	res = cf1124_read_configuration(cf1124, 0);
+	if (res < 0) {
+		dev_err(&i2c->dev, "failed to read chip configuration\n");
+		goto err_out;
+	}
+
+	// enable the interrupt
+	enable_irq(cf1124->client->irq);
+
+	return 0;
+
+err_out:
+	// put the chip in reset
+	gpiod_set_value_cansleep(cf1124->reset_gpio, 1);
+	usleep_range(STOP_DELAY_MIN_US, STOP_DELAY_MAX_US);
+
+	return res;
+}
+
+static void cf1124_stop_chip(struct input_dev *dev)
+{
+	struct cf1124_ts_data *cf1124 = input_get_drvdata(dev);
+
+	// disable the interrupt
+	disable_irq(cf1124->client->irq);
+
+	// reset the chip
+	gpiod_set_value_cansleep(cf1124->reset_gpio, 1);
+	usleep_range(STOP_DELAY_MIN_US, STOP_DELAY_MAX_US);
+}
+
+static int cf1124_ts_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cf1124_ts_data *cf1124;
+	struct input_dev *in_dev;
+	unsigned long irq_flags;
+	int error;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_SMBUS_BYTE_DATA |
+				     I2C_FUNC_SMBUS_WRITE_BYTE |
+				     I2C_FUNC_SMBUS_WRITE_BYTE_DATA |
+				     I2C_FUNC_SMBUS_READ_I2C_BLOCK)) {
+		dev_err(dev, "I2C functionality support is not sufficient\n");
+		return -EIO;
+	}
+
+	cf1124 = devm_kzalloc(dev, sizeof(*cf1124), GFP_KERNEL);
+	if (!cf1124)
+		return -ENOMEM;
+
+	error = device_property_read_u32(dev, "orientation", &cf1124->orientation);
+	if (error) {
+		dev_err(dev, "invalid 'orientation' supplied: %d\n", error);
+		return error;
+	}
+
+	cf1124->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(cf1124->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(cf1124->reset_gpio),
+				     "failed to acquire 'reset' gpio\n");
+	else
+		gpiod_set_consumer_name(cf1124->reset_gpio, "cs1124 reset");
+
+	in_dev = devm_input_allocate_device(dev);
+	if (!in_dev) {
+		dev_err(dev, "unable to allocate input device\n");
+		return -ENOMEM;
+	}
+
+	cf1124->client = client;
+	cf1124->in_dev = in_dev;
+
+	input_set_drvdata(in_dev, cf1124);
+
+	// take the chip out of reset
+	gpiod_set_value_cansleep(cf1124->reset_gpio, 0);
+	msleep(START_DELAY_MS);
+
+	// read the chip information
+	error = cf1124_read_configuration(cf1124, 1);
+	
+	// reset the chip
+	gpiod_set_value_cansleep(cf1124->reset_gpio, 1);
+	usleep_range(STOP_DELAY_MIN_US, STOP_DELAY_MAX_US);
+	
+	// check if there was an error reading the configuration
+	if (error) {
+		dev_err(dev, "failed to read chip information: %d\n", error);
+		return error;
+	}
+
+	in_dev->name		= "cf1124";
+	in_dev->id.bustype	= BUS_I2C;
+	in_dev->open		= cf1124_start_chip;
+	in_dev->close		= cf1124_stop_chip;
+
+	input_set_capability(in_dev, EV_KEY, BTN_TOUCH);
+	input_set_abs_params(in_dev, ABS_X, 0, cf1124->max_x, 0, 0);
+	input_set_abs_params(in_dev, ABS_Y, 0, cf1124->max_y, 0, 0);
+	input_set_abs_params(in_dev, ABS_PRESSURE, 0, 1, 0, 0);
+	touchscreen_parse_properties(in_dev, false, &cf1124->props);
+
+	irq_flags = irq_get_trigger_type(client->irq);
+	error = devm_request_threaded_irq(dev, client->irq, NULL,
+					cf1124_touch_soft_irq,
+					(irq_flags | IRQF_ONESHOT | IRQF_NO_AUTOEN),
+					"cf1124", cf1124);
+	if (error) {
+		dev_err(dev, "unable to request touch irq: %d\n", error);
+		return error;
+	}
+
+	error = input_register_device(in_dev);
+	if (error) {
+		dev_err(dev, "unable to register input device: %d\n", error);
+		return error;
+	}
+
+	i2c_set_clientdata(client, cf1124);
+
+	return 0;
+}
+
+static int cf1124_suspend(struct device *dev)
+{
+	struct i2c_client *i2c = to_i2c_client(dev);
+	struct cf1124_ts_data *cf1124 = i2c_get_clientdata(i2c);
+
+	if (!device_may_wakeup(dev)) {
+		mutex_lock(&cf1124->in_dev->mutex);
+		if (input_device_enabled(cf1124->in_dev))
+			cf1124_stop_chip(cf1124->in_dev);
+		mutex_unlock(&cf1124->in_dev->mutex);
+	}
+
+	return 0;
+}
+
+static int cf1124_resume(struct device *dev)
+{
+	struct i2c_client *i2c = to_i2c_client(dev);
+	struct cf1124_ts_data *cf1124 = i2c_get_clientdata(i2c);
+
+	if (!device_may_wakeup(dev)) {
+		mutex_lock(&cf1124->in_dev->mutex);
+		if (input_device_enabled(cf1124->in_dev))
+			cf1124_start_chip(cf1124->in_dev);
+		mutex_unlock(&cf1124->in_dev->mutex);
+	}
+
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(cf1124_pm_ops, cf1124_suspend, cf1124_resume);
+
+static const struct i2c_device_id cf1124_ts_id[] = {
+	{ .name = "cf1124" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(i2c, cf1124_ts_id);
+
+static const struct of_device_id cf1124_of_match[] = {
+	{ .compatible = "sitronix,cf1124" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cf1124_of_match);
+
+static struct i2c_driver cf1124_ts_driver = {
+	.driver = {
+		.name = "cf1124",
+		.of_match_table = of_match_ptr(cf1124_of_match),
+		.pm		= pm_sleep_ptr(&cf1124_pm_ops),
+	},
+	.id_table = cf1124_ts_id,
+	.probe    = cf1124_ts_probe
+};
+
+module_i2c_driver(cf1124_ts_driver);
+
+MODULE_AUTHOR("Nick v. IJzendoorn <nick.vanijzendoorn@confed.eu>");
+MODULE_DESCRIPTION("Sitronix CF1124 I2C Touchscreen Driver");
+MODULE_LICENSE("GPL v2");
+
-- 
